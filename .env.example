# Leave blank for local and preview builds. Configure the real public ID only
# in the approved production environment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# This enables the first-party consent control. It does not load Google
# Analytics until an individual visitor chooses Allow analytics.
NEXT_PUBLIC_AEORA_ANALYTICS_ENABLED=false

# Article readership counting remains disabled unless a production owner enables
# it after connecting an approved Redis integration. These variables are
# server-only. Do not add any of them with a NEXT_PUBLIC_ prefix.
ARTICLE_VIEW_COUNTER_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ARTICLE_VIEW_COUNTER_RATE_LIMIT_SECRET=
